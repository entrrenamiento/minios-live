#!/bin/bash
# ============================================================
# Modulo 10-dev-web: instala dev C++ + navegador + OpenCode
# Se ejecuta dentro del chroot durante build-modules.
# ============================================================
set -e
set -o pipefail
set -u

. /minioslib || exit 1
console_colors
. /minios_build.conf || exit 1

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Colores PROPIOS, definidos siempre. No dependemos de minioslib para esto
# (evita "unbound variable" bajo set -u si la lib cambia).
C_INFO=$'\e[1;36m'
C_OK=$'\e[1;32m'
C_WARN=$'\e[1;33m'
C_ERR=$'\e[1;31m'
C_END=$'\e[0m'

# ------------------------------------------------------------
# 1) Paquetes del sistema via CondinAPT
#    (C++, Geany, navegador, codigos de video, curl)
# ------------------------------------------------------------
/condinapt \
  -l "${SCRIPT_DIR}/packages.list" \
  -c "${SCRIPT_DIR}/minios_build.conf" \
  -m "${SCRIPT_DIR}/condinapt.map"

# ------------------------------------------------------------
# 2) Agente OpenCode (binario unico, modelos gratis incluidos)
#    No fatal: si falla, se reinstala en el primer arranque.
# ------------------------------------------------------------
if ! command -v opencode >/dev/null 2>&1; then
  echo "${C_INFO}Instalando OpenCode...${C_END}"

  # Variables del entorno de CI que pueden confundir al instalador
  unset GITHUB_ACTIONS GITHUB_PATH 2>/dev/null || true

  if command -v curl >/dev/null 2>&1; then
    # Instalador oficial (binario). --no-modify-path evita tocar el shell.
    curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path || true
  else
    echo "${C_WARN}curl no disponible; se omite la instalacion previa de OpenCode.${C_END}"
  fi

  # El instalador lo coloca en el home de root; hacerlo visible para todos.
  for p in /root/.opencode/bin/opencode /root/.local/bin/opencode /root/.opencode/bin/opencode-*; do
    if [ -x "$p" ]; then
      install -m 755 "$p" /usr/local/bin/opencode
      break
    fi
  done

  if command -v opencode >/dev/null 2>&1; then
    echo "${C_OK}OpenCode instalado en /usr/local/bin/opencode${C_END}"
  else
    echo "${C_WARN}AVISO: OpenCode pudo no instalarse ahora. Se reinstala en el primer arranque.${C_END}"
    # Respaldo: reinstalar en el primer boot del usuario
    cat > /etc/profile.d/opencode-firstboot.sh <<'EOF'
#!/bin/sh
if ! command -v opencode >/dev/null 2>&1; then
  curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path >/dev/null 2>&1 || true
  [ -x "$HOME/.opencode/bin/opencode" ] && sudo install -m 755 "$HOME/.opencode/bin/opencode" /usr/local/bin/opencode
fi
EOF
    chmod +x /etc/profile.d/opencode-firstboot.sh
  fi
fi

echo "${C_OK}Modulo 10-dev-web completado${C_END}"
